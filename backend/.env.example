# StockSense Enterprise Backend Environment Configuration

# Server
PORT=5000
NODE_ENV=development

# Database Credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stocksense
DB_USER=postgres
DB_PASSWORD=your_secure_password

# Authentication & JWT
JWT_SECRET=stocksense_enterprise_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# Email Service (for OTP & Password Resets)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM="StockSense <no-reply@stocksense.io>"

# OTP Expiration (Minutes)
OTP_EXPIRES_IN=10
